APP_ENV=development
APP_NAME=ZubePredict AI
API_HOST=0.0.0.0
API_PORT=8040
API_BASE_URL=http://localhost:8040
WEB_BASE_URL=http://localhost:3040
CORS_ORIGINS=http://localhost:3040

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATASETS_BUCKET=datasets
SUPABASE_ARTIFACTS_BUCKET=artifacts

LLM_PROVIDER=template
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/NousResearch/Hermes-3-Llama-3.1-8B-GGUF:Q4_K_M
LLM_TIMEOUT_SECONDS=60

# Server-side Hermes-to-ZubePredict boundary. Generate a long random value locally.
# Rotation format: key-id:secret,key-id-2:secret-2 (never expose this to browser code).
HERMES_SERVICE_KEYS=
# Development-only UUID for the local CLI principal. Production refuses this mechanism.
HERMES_DEV_PRINCIPAL_ID=
HERMES_REQUEST_TIMEOUT_SECONDS=15
HERMES_MAX_CLOCK_SKEW_SECONDS=300
HERMES_REPLAY_TTL_SECONDS=600
HERMES_TELEGRAM_OWNER_ID=
HERMES_TELEGRAM_UNSAFE_ALLOW_ALL=false
HERMES_TELEGRAM_REPORT_TTL_SECONDS=300
TELEGRAM_LINKING_CODE_SECRET=
TELEGRAM_LINKING_CODE_TTL_SECONDS=600
TELEGRAM_LINKING_MAX_ATTEMPTS=5
TELEGRAM_LINKING_ATTEMPT_WINDOW_SECONDS=600

# Disabled aiogram fallback only. Leave blank while the Hermes gateway is active.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
ZUBEPREDICT_ENABLE_AIOGRAM_FALLBACK=false

MAX_UPLOAD_MB=10
MAX_ROWS=50000
MAX_COLUMNS=100
DATASET_PREVIEW_ROWS=25
DATASET_PREVIEW_COLUMNS=25
DATASET_RETENTION_DAYS=30
TRAINING_TIMEOUT_SECONDS=600
MAX_CANDIDATE_MODELS=5
MAX_OPTUNA_TRIALS=10
OPTUNA_TIMEOUT_SECONDS=120
USER_MAX_OPTUNA_TRIALS=20
USER_OPTUNA_TIMEOUT_SECONDS=180
TUNING_MAX_CANDIDATES=2
EXPLANATION_MAX_SAMPLE_ROWS=200
EXPLANATION_BACKGROUND_ROWS=50
EXPLANATION_LOCAL_ROWS=5
EXPLANATION_MAX_FEATURES=15
EXPLANATION_PLOT_SAMPLE_ROWS=500
EXPLANATION_LEARNING_CURVE_ROWS=2000
RANDOM_SEED=42
FORECAST_MAX_HORIZON=365
FORECAST_VALIDATION_FOLDS=3
FORECAST_MAX_ARIMA_ITERATIONS=50
JOB_STALE_AFTER_SECONDS=1200
JOB_LOCK_TTL_SECONDS=900
JOB_MAX_RETRIES=2
JOB_MIN_BACKOFF_MS=5000
JOB_MAX_BACKOFF_MS=60000

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8040/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
