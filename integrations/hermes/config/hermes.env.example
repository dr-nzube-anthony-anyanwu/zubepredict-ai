# Copy these variable names to %LOCALAPPDATA%\hermes\.env and set values locally.
# Never commit the populated file or paste its values into chat or logs.
ZUBEPREDICT_API_BASE_URL=http://127.0.0.1:8040/api/v1
ZUBEPREDICT_HERMES_KEY_ID=
ZUBEPREDICT_HERMES_SERVICE_KEY=
ZUBEPREDICT_HERMES_PRINCIPAL_ID=
ZUBEPREDICT_HERMES_TIMEOUT_SECONDS=15
ZUBEPREDICT_ENV=development

# Official Hermes Telegram gateway. Copy names into %LOCALAPPDATA%\hermes\.env,
# set values privately, and never paste the token into chat or commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
GATEWAY_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_USERS=
TELEGRAM_GROUP_ALLOWED_CHATS=
ZUBEPREDICT_TELEGRAM_OWNER_ID=
ZUBEPREDICT_TELEGRAM_UNSAFE_ALLOW_ALL=false
ZUBEPREDICT_TELEGRAM_ATTACHMENT_ROOT=C:\Users\YOUR_WINDOWS_USER\AppData\Local\hermes\cache\documents
ZUBEPREDICT_TELEGRAM_MAX_UPLOAD_MB=10

# Hermes/OpenRouter configuration is managed by Hermes itself. Keep the key only
# in the Hermes environment and choose a currently supported tool-capable model.
OPENROUTER_API_KEY=
